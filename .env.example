# Environment variables for AI-Native Learning Platform
#
# Copy this file to .env.local and fill in real values.

# --- account-course-artifact-foundation (specs/002-account-course-artifact-foundation) ---
# No live Supabase/Trigger.dev accounts exist yet as of this feature's
# implementation (confirmed with product owner 2026-09-01) — these
# variables are documented now so the code has a stable contract to
# reference; fill in real values once accounts are provisioned, per
# specs/002-account-course-artifact-foundation/quickstart.md Group B1.

# Supabase project URL and anon (public) key.
# Found in: Supabase dashboard -> Project Settings -> API.
# NEXT_PUBLIC_* vars are exposed to the browser -- the anon key is safe to
# expose because Postgres row-level security (not this key) enforces
# per-user data isolation.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key. SERVER-ONLY -- never prefix with NEXT_PUBLIC_,
# never send to the browser. Bypasses row-level security; used only by the
# Trigger.dev background task (trigger/ingest-artifact.ts), which acts on
# behalf of the system rather than any single student's session.
# Found in: Supabase dashboard -> Project Settings -> API -> service_role key.
SUPABASE_SERVICE_ROLE_KEY=

# Trigger.dev secret key, used to authenticate this app with the
# Trigger.dev platform when triggering/running the ingest-artifact task.
# Found in: Trigger.dev dashboard -> Project -> API Keys.
TRIGGER_SECRET_KEY=

# --- course-graph-ingestion (Phase 2, not yet built) ---
# SERVER-ONLY -- never prefix with NEXT_PUBLIC_. Used for concept
# extraction from uploaded course material. Found in: OpenAI platform
# dashboard -> API keys.
OPENAI_API_KEY=
